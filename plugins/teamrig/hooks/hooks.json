{
  "description": "teamrig: ask before a push to a protected branch, and remind a session of unread inbox lines.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli/main.js\" hook push-guard", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli/main.js\" hook inbox-reminder", "timeout": 15 }
        ]
      }
    ]
  }
}
