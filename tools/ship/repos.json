{
  "GeneralA6/teamrig": {
    "aliases": ["teamrig/teamrig"],
    "main": "main",
    "gate": "ci",
    "checks": [
      "change kind",
      "scrub and DCO gates",
      "dependency review",
      "commit size rule",
      "commit subject gate",
      "coverage gate",
      "test (ubuntu-latest, node 22)",
      "test (windows-latest, node 22)",
      "test (macos-latest, node 22)",
      "every check passed"
    ],
    "summary": "every check passed",
    "local": {
      "runner": "tools/ci/local.ts"
    },
    "regenerated": ["plugins/teamrig/dist/", "plugins/teamrig/.claude-plugin/plugin.json", "src/core/version.ts", ".release-please-manifest.json"],
    "flaky": ["test (ubuntu-latest, node 22)", "test (windows-latest, node 22)", "test (macos-latest, node 22)"],
    "conditional": ["test (windows-latest, node 22)", "test (macos-latest, node 22)"],
    "mergeChecks": "changed",
    "pullSections": ["Reach", "Risks"],
    "release": { "head": "release-please--branches--main--components--teamrig", "changelog": "CHANGELOG.md" }
  },
  "GeneralA6/teamrig-pane": {
    "aliases": ["teamrig/teamrig-pane"],
    "main": "main",
    "gate": "ci",
    "checks": [
      "scrub and DCO gates",
      "commit size rule",
      "commit subject gate",
      "coverage gate",
      "hooks/core matches the teamrig pin",
      "test (ubuntu-latest, node 22)",
      "test (windows-latest, node 22)",
      "test (macos-latest, node 22)",
      "every check passed"
    ],
    "summary": "every check passed",
    "local": {
      "runner": "tools/ci/local.ts"
    },
    "regenerated": ["plugins/teamrig-pane/.claude-plugin/plugin.json", ".release-please-manifest.json"],
    "release": { "head": "release-please--branches--main--components--teamrig-pane", "changelog": "CHANGELOG.md" }
  }
}
